# ============================================================================
# 房屋租赁管理系统 · 本地/服务器环境变量模板
#
# 用法：复制为 .env 后按实际环境填写（.env 已被 .gitignore 忽略，不会入库）
#   cp .env.example .env        # Linux / macOS
#   copy .env.example .env      # Windows
#
# 一键启动脚本（start.sh / start.cmd）会自动读取同目录下的 .env。
# 已存在的系统环境变量优先级高于 .env，便于容器/CI 直接注入。
# ============================================================================

# ---------------------------------------------------------------------------
# 服务端口
# 注意：不要用 SERVER_PORT / PORT 作为键名 —— 部分云平台与 CI 沙箱会自动
# 注入这两个变量（实测曾把端口改成 52051 导致启动失败）。脚本统一用
# HRENT_PORT，并显式传 --server.port 覆盖，避免被外部变量劫持。
# ---------------------------------------------------------------------------
HRENT_PORT=8888

# 前端开发服务器端口（仅 `dev` 命令使用；生产由后端托管 dist，不占该端口）
HRENT_WEB_PORT=8080

# ---------------------------------------------------------------------------
# 数据库（MySQL 5.7+ / 8.0）
# 密码不要写进代码仓库；部署时通过本文件或容器 Secret 注入
# ---------------------------------------------------------------------------
DB_URL=jdbc:mysql://127.0.0.1:3306/house_rent?useUnicode=true&characterEncoding=utf8&serverTimezone=GMT%2B8&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# JWT 签名密钥（生产环境务必替换为随机值，建议 32 字节以上）
# 生成方式：openssl rand -base64 32
# ---------------------------------------------------------------------------
TOKEN_SECRET=change-me-to-a-random-32-bytes-secret

# ---------------------------------------------------------------------------
# 微信小程序凭据（可选；留空时微信登录接口会返回明确错误，不会伪造登录）
# ---------------------------------------------------------------------------
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---------------------------------------------------------------------------
# JVM 参数（按机器内存调整；服务器 2C4G 建议 -Xmx512m）
# ---------------------------------------------------------------------------
JAVA_OPTS=-Xms256m -Xmx512m -Dfile.encoding=UTF-8
