<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wt.hrentSystem.ai.dao.AiFeedbackDao">

    <resultMap id="AiFeedbackMap" type="com.wt.hrentSystem.ai.entity.AiFeedback">
        <result property="id" column="id" jdbcType="VARCHAR"/>
        <result property="userId" column="user_id" jdbcType="VARCHAR"/>
        <result property="query" column="query" jdbcType="VARCHAR"/>
        <result property="houseId" column="house_id" jdbcType="VARCHAR"/>
        <result property="action" column="action" jdbcType="VARCHAR"/>
        <result property="position" column="position" jdbcType="INTEGER"/>
        <result property="mode" column="mode" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="feedbackCols">
        id, user_id, `query`, house_id, action, position, mode, create_time
    </sql>

    <insert id="insert">
        insert into ai_feedback (<include refid="feedbackCols"/>)
        values (#{id}, #{userId}, #{query}, #{houseId}, #{action}, #{position}, #{mode}, #{createTime})
    </insert>

    <select id="findList" resultMap="AiFeedbackMap">
        select <include refid="feedbackCols"/>
        from ai_feedback
        <where>
            <if test="id != null and id != ''">and id = #{id}</if>
            <if test="userId != null and userId != ''">and user_id = #{userId}</if>
            <if test="houseId != null and houseId != ''">and house_id = #{houseId}</if>
            <if test="action != null and action != ''">and action = #{action}</if>
            <if test="mode != null and mode != ''">and mode = #{mode}</if>
        </where>
        order by create_time desc
    </select>

</mapper>
