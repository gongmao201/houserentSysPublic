<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wt.hrentSystem.common.dao.UserRoleDao">

    <resultMap id="UserRoleMap" type="com.wt.hrentSystem.common.entity.UserRole">
        <result property="id" column="id" jdbcType="VARCHAR"/>
        <result property="userId" column="user_id" jdbcType="VARCHAR"/>
        <result property="role" column="role" jdbcType="VARCHAR"/>
        <result property="scopeId" column="scope_id" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="userRoleCols">id, user_id, role, scope_id, create_time</sql>

    <insert id="insert">
        insert into user_role (<include refid="userRoleCols"/>)
        values (#{id}, #{userId}, #{role}, #{scopeId}, #{createTime})
    </insert>

    <select id="findByUserId" resultMap="UserRoleMap">
        select <include refid="userRoleCols"/>
        from user_role
        where user_id = #{userId}
        order by create_time
    </select>

    <select id="findList" resultMap="UserRoleMap">
        select <include refid="userRoleCols"/>
        from user_role
        <where>
            <if test="id != null and id != ''">and id = #{id}</if>
            <if test="userId != null and userId != ''">and user_id = #{userId}</if>
            <if test="role != null and role != ''">and role = #{role}</if>
            <if test="scopeId != null and scopeId != ''">and scope_id = #{scopeId}</if>
        </where>
        order by create_time
    </select>

    <delete id="deleteByUserAndRole">
        delete from user_role
        where user_id = #{userId} and role = #{role}
    </delete>

</mapper>
