<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wt.hrentSystem.rating.dao.ReviewDao">

    <resultMap id="ReviewMap" type="com.wt.hrentSystem.rating.entity.Review">
        <result property="id" column="id" jdbcType="VARCHAR"/>
        <result property="leaseId" column="lease_id" jdbcType="VARCHAR"/>
        <result property="reviewerId" column="reviewer_id" jdbcType="VARCHAR"/>
        <result property="targetType" column="target_type" jdbcType="VARCHAR"/>
        <result property="targetId" column="target_id" jdbcType="VARCHAR"/>
        <result property="score" column="score" jdbcType="DECIMAL"/>
        <result property="dimensions" column="dimensions" jdbcType="VARCHAR"/>
        <result property="content" column="content" jdbcType="VARCHAR"/>
        <result property="images" column="images" jdbcType="VARCHAR"/>
        <result property="status" column="status" jdbcType="VARCHAR"/>
        <result property="reply" column="reply" jdbcType="VARCHAR"/>
        <result property="replyAt" column="reply_at" jdbcType="TIMESTAMP"/>
        <result property="createDate" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateDate" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="delFlag" column="del_flag" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="reviewCols">
        id, lease_id, reviewer_id, target_type, target_id, score, dimensions,
        content, images, status, reply, reply_at, create_time, update_time, del_flag
    </sql>

    <select id="get" resultMap="ReviewMap">
        select <include refid="reviewCols"/>
        from review
        where id = #{id} and del_flag = 0
    </select>

    <select id="getByEntity" resultMap="ReviewMap">
        select <include refid="reviewCols"/>
        from review
        <where>
            del_flag = 0
            <if test="id != null and id != ''">and id = #{id}</if>
            <if test="leaseId != null and leaseId != ''">and lease_id = #{leaseId}</if>
            <if test="reviewerId != null and reviewerId != ''">and reviewer_id = #{reviewerId}</if>
            <if test="targetType != null and targetType != ''">and target_type = #{targetType}</if>
            <if test="targetId != null and targetId != ''">and target_id = #{targetId}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by create_time desc
        limit 1
    </select>

    <select id="findList" resultMap="ReviewMap">
        select <include refid="reviewCols"/>
        from review
        <where>
            del_flag = 0
            <if test="id != null and id != ''">and id = #{id}</if>
            <if test="leaseId != null and leaseId != ''">and lease_id = #{leaseId}</if>
            <if test="reviewerId != null and reviewerId != ''">and reviewer_id = #{reviewerId}</if>
            <if test="targetType != null and targetType != ''">and target_type = #{targetType}</if>
            <if test="targetId != null and targetId != ''">and target_id = #{targetId}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

    <select id="findAllList" resultMap="ReviewMap">
        select <include refid="reviewCols"/>
        from review
        where del_flag = 0
        order by create_time desc
    </select>

    <insert id="insert">
        insert into review (<include refid="reviewCols"/>)
        values (#{id}, #{leaseId}, #{reviewerId}, #{targetType}, #{targetId}, #{score},
                #{dimensions}, #{content}, #{images}, #{status}, #{reply}, #{replyAt},
                #{createDate}, #{updateDate}, #{delFlag})
    </insert>

    <update id="update">
        update review
        <set>
            <if test="leaseId != null and leaseId != ''">lease_id = #{leaseId},</if>
            <if test="reviewerId != null and reviewerId != ''">reviewer_id = #{reviewerId},</if>
            <if test="targetType != null and targetType != ''">target_type = #{targetType},</if>
            <if test="targetId != null and targetId != ''">target_id = #{targetId},</if>
            <if test="score != null">score = #{score},</if>
            <if test="dimensions != null">dimensions = #{dimensions},</if>
            <if test="content != null">content = #{content},</if>
            <if test="images != null">images = #{images},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="reply != null">reply = #{reply},</if>
            <if test="replyAt != null">reply_at = #{replyAt},</if>
            <if test="updateDate != null">update_time = #{updateDate},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </set>
        where id = #{id}
    </update>

    <update id="deleteById">
        update review set del_flag = 1 where id = #{id}
    </update>

    <update id="delete">
        update review set del_flag = 1 where id = #{id}
    </update>

    <select id="findByLeaseId" resultMap="ReviewMap">
        select <include refid="reviewCols"/>
        from review
        where lease_id = #{leaseId} and del_flag = 0
        order by create_time desc
    </select>

    <select id="findByTarget" resultMap="ReviewMap">
        select <include refid="reviewCols"/>
        from review
        where target_type = #{targetType} and target_id = #{targetId} and del_flag = 0
        order by create_time desc
    </select>

</mapper>
